rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Identity is verified against the admins collection or a specific hardcoded email
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == "oceantidedrop@gmail.com" && isEmailVerified())
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && (data.role in ['user', 'admin'])
        && (data.subscriptionStatus in ['none', 'active', 'canceled'])
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100));
    }

    function isValidPublicUser(data) {
      return data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('bio' in data) || (data.bio is string && data.bio.size() <= 500))
        && (!('location' in data) || (data.location is string && data.location.size() <= 100));
    }

    function isValidChatMessage(data) {
      return data.user_id == request.auth.uid
        && data.username is string && data.username.size() > 0 && data.username.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 500
        && data.created_at == request.time;
    }

    function isValidMemorialStory(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.content is string && data.content.size() > 0 && data.content.size() <= 2000
        && data.created_at == request.time;
    }

    // --- Rules ---

    // USERS COLLECTION (Private PII)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if (isOwner(userId) || isAdmin())
        && isValidUser(incoming())
        && (
          // Admin can change status or role
          isAdmin() || (
            // User can change profile info, but not role/status
            incoming().role == existing().role
            && incoming().subscriptionStatus == existing().subscriptionStatus
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'location'])
          )
        );
      allow delete: if isAdmin();
    }

    // USERS_PUBLIC COLLECTION (Directory)
    match /users_public/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidPublicUser(incoming());
      allow update: if isOwner(userId) && isValidPublicUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'bio', 'location']);
      allow delete: if isAdmin();
    }

    // CHAT MESSAGES
    match /chat_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isEmailVerified() && isValidChatMessage(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // MEMORIAL STORIES
    match /memorial_stories/{storyId} {
      allow read: if true;
      allow create: if isEmailVerified() && isValidMemorialStory(incoming());
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ADMINS (System)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // SYSTEM LOGS
    match /system_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // ADMIN EVENTS
    match /admin_events/{eventId} {
      allow read, write: if isAdmin();
    }

    // PAGE VIEWS
    match /page_views/{viewId} {
      allow read: if isAdmin();
      allow create: if incoming().path is string 
        && incoming().count is number 
        && incoming().createdAt == request.time;
    }
  }
}
